APP_ENV=mainnet
PORT=3000
ADMIN_SECRET=replace-with-mainnet-admin-secret
MAX_MINTS=3
MINT_WINDOW_MS=60000
# Behind a reverse proxy / load balancer, set the number of trusted proxy hops
# (e.g. 1) so the global rate limiter keys on the real client IP. Leave unset when
# the app is exposed directly. Do not use `true` unless the proxy strips
# client-supplied X-Forwarded-For.
# TRUST_PROXY=1

STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=replace-with-mainnet-rpc-url
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

HUNTY_CORE_ID=replace-with-mainnet-hunty-core-contract-id
REWARD_MANAGER_ID=replace-with-mainnet-reward-manager-contract-id
NFT_REWARD_ID=replace-with-mainnet-nft-reward-contract-id
